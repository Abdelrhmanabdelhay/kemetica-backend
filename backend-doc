### `TourController.js` — key logic

```js
// GET /api/v1/tours?category=historical&destination=luxor&q=pyramid&maxPrice=2000&tour_type=special
exports.getAll = async (req, res) => {
  const { category, destination, maxPrice, q, tour_type } = req.query;
  const filter = {};

  if (category && category !== 'all') filter.category = category;
  if (destination)                    filter.destination = destination;  // ← icon filter
  if (maxPrice)                       filter.price_usd = { $lte: Number(maxPrice) };
  if (tour_type)                      filter.tour_type = tour_type;
  if (q)                              filter.$text = { $search: q };

  const tours = await Tour.find(filter).sort('-is_featured -rating_score');
  res.json({ status: 'success', results: tours.length, data: tours });
};

// GET /api/v1/tours/featured  (Home page card grid)
exports.getFeatured = async (req, res) => {
  const tours = await Tour.find({ is_featured: true }).limit(6).sort('-rating_score');
  res.json({ status: 'success', data: tours });
};

// GET /api/v1/tours/special  (Home "Don't miss / Special Tours" section)
exports.getSpecial = async (req, res) => {
  const { destination } = req.query;   // ← filtered by icon click
  const filter = { tour_type: 'special' };
  if (destination) filter.destination = destination;
  const tours = await Tour.find(filter).limit(6);
  res.json({ status: 'success', data: tours });
};

// GET /api/v1/tours/:slug
exports.getOne = async (req, res) => {
  const tour = await Tour.findOne({
    $or: [{ slug: req.params.slug }, { _id: req.params.slug }]
  });
  if (!tour) return res.status(404).json({ status: 'error', message: 'Tour not found' });
  res.json({ status: 'success', data: tour });
};
```

