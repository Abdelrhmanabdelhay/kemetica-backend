## MongoDB Models (Mongoose Schemas)

### 1. `Tour` Model
**Source:** [`tour.dto.ts`](file:///d:/kemetica/src/app/data/dto/tour.dto.ts) · [`tour.model.ts`](file:///d:/kemetica/src/app/domain/models/tour.model.ts)

> **Critical:** Field names must be **snake_case** to match `TourDto` exactly, since [`TourMapper`](file:///d:/kemetica/src/app/data/mappers/tour.mapper.ts) uses them directly.

```js
// models/Tour.js
const mongoose = require('mongoose');

const ItineraryDaySchema = new mongoose.Schema({
  day:         { type: Number, required: true },
  title:       { type: String, required: true },
  description: { type: String, required: true },
  activities:  [{ type: String }],
  meals:       [{ type: String }],   // e.g. ['Breakfast', 'Lunch', 'Dinner']
});

const TourSchema = new mongoose.Schema({
  title:              { type: String, required: true, trim: true },
  slug:               { type: String, required: true, unique: true, lowercase: true },
  tagline:            { type: String, required: true },
  description:        { type: String, required: true },
  category: {
    type: String,
    required: true,
    // Used in /tours page category tab filter
    enum: ['historical', 'luxury-nile', 'desert-safari', 'cultural', 'diving'],
  },
  destination: {
    type: String,
    required: true,
    // Used in Home page destination icon filter
    enum: ['giza', 'luxor', 'aswan', 'abusimbel', 'sharm', 'siwa', 'hurghada'],
  },
  duration_days:      { type: Number, required: true },
  price_usd:          { type: Number, required: true },
  rating_score:       { type: Number, default: 0, min: 0, max: 5 },
  reviews_count:      { type: Number, default: 0 },
  max_group_size:     { type: Number, required: true },
  featured_image_url: { type: String, required: true },
  gallery_urls:       [{ type: String }],
  highlights:         [{ type: String }],
  city:               { type: String, required: true },
  country:            { type: String, required: true, default: 'Egypt' },
  coordinates: {
    lat: Number,
    lng: Number,
  },
  itinerary:         [ItineraryDaySchema],
  included_items:    [{ type: String }],
  excluded_items:    [{ type: String }],
  is_featured:       { type: Boolean, default: false },
  badge_label:       { type: String },
  // For "Popular" / "Special" tour type badges on home page
  tour_type: {
    type: String,
    enum: ['special', 'popular', 'new', 'exclusive', 'standard'],
    default: 'standard',
  },
}, { timestamps: true });

// Indexes for fast filtering
TourSchema.index({ category: 1, is_featured: 1 });
TourSchema.index({ destination: 1 });
TourSchema.index({ slug: 1 });
TourSchema.index({ title: 'text', tagline: 'text', description: 'text' });

module.exports = mongoose.model('Tour', TourSchema);
```

